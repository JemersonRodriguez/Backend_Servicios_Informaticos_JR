{
  "profiles": {
    // 1. PERFIL CREADO PARA ACCESO EN RED LOCAL (CORREGIDO)
    "AccesoLocalRed": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://192.168.1.156:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },

    // 2. PERFIL HTTP POR DEFECTO (MOVIDO AL NIVEL CORRECTO)
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5229"
    },

    // 3. PERFIL HTTPS POR DEFECTO (MOVIDO AL NIVEL CORRECTO)
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7228;http://localhost:5229"
    },

    // 4. PERFIL IIS EXPRESS (MOVIDO AL NIVEL CORRECTO)
    "IIS Express": {
      "commandName": "IISExpress",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },

    // 5. PERFIL CONTAINER (DOCKERFILE) (MOVIDO AL NIVEL CORRECTO)
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },

  // METADATOS Y AJUSTES DE IIS
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    "windowsAuthentication": false,
    "anonymousAuthentication": true,
    "iisExpress": {
      "applicationUrl": "http://localhost:61040",
      "sslPort": 44374
    }
  }
}